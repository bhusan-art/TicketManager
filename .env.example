# Copy to .env (Windows: copy .env.example .env). Docker Compose reads it automatically.
# For local development (npm run dev:*), the apps read the same names from the environment.

# ---- Ports and address ----
# Where people open the app. Used for cookies, CORS, links in emails and Google sign-in.
# Must match WEB_PORT when running on your own machine.
PUBLIC_URL=http://localhost:9080
WEB_PORT=9080
# HTTPS turns on when deploy/certs has fullchain.pem and privkey.pem (see docs/DEPLOY.md).
# On a server use WEB_PORT=80, HTTPS_PORT=443 and PUBLIC_URL=https://<your domain>.
HTTPS_PORT=9443
# PostgreSQL on your machine (127.0.0.1 only). 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=5433
LOG_LEVEL=info

# ---- Secrets: change all of these before the first real start ----
# Database password (set when the database volume is first created).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Signs sign-in tokens. At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters-please

# ---- First admin ----
# Created on the first start when the database has no users. Sign in with these, then change
# the password from your profile. Needs 8+ characters, an uppercase letter, a number and a symbol.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe#2026
BOOTSTRAP_ADMIN_NAME=Administrator

# ---- Google sign-in (optional) ----
# Leave empty to hide the Google button. See README "Google sign-in" for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email ----
# The defaults send to the local mail catcher (http://localhost:8025).
# For a real mailbox, e.g. Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TicketManager <no-reply@ticketmanager.local>

# ---- Backups ----
# A full database backup every night at BACKUP_TIME (in TZ), kept BACKUP_KEEP_DAYS days, in
# BACKUP_DIR on the host. Copy that folder off the server too (see docs/DEPLOY.md).
TZ=Asia/Kolkata
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# ---- Only for running the apps outside Docker (npm run dev:api / dev:worker) ----
# DATABASE_URL=postgres://ticketmanager:<POSTGRES_PASSWORD>@localhost:5433/ticketmanager
# REDIS_URL=redis://localhost:6379
# SMTP_HOST=localhost
# PUBLIC_URL=http://localhost:5173
