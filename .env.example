# Copy to .env. Docker Compose reads it automatically.
# For local development (npm run dev:*), the apps read the same names from the environment.

# Where people open the app. Used for CORS and, from Phase 1, for links in emails.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
LOG_LEVEL=info

# File storage (S3-compatible). Change both before the first real start.
S3_ACCESS_KEY=ticketmanager
S3_SECRET_KEY=change-me-to-a-long-random-string
S3_BUCKET=ticketmanager

# Email. The defaults send to the local mail catcher (http://localhost:8025).
# For a real mailbox, e.g. Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TicketManager <no-reply@ticketmanager.local>

# Only for running the apps outside Docker (npm run dev:api / dev:worker):
# MONGO_URL=mongodb://localhost:27017/ticketmanager?directConnection=true
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:8333
# SMTP_HOST=localhost
